   "source": [
    "\n",
    "import json\n",
    "import requests\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "# Configurações\n",
    "URL = \"https://api.infosimples.com/api/v2/consultas/sefaz/es/nfce\"\n",
    "\n",
    "VOLUME = \"/Volumes/workspace/tributo_bronze/notas_fiscais\"\n",
    "\n",
    "# 1. Receber a chave de acesso\n",
    "dbutils.widgets.text(\"chave_acesso\", \"\")\n",
    "\n",
    "chave = dbutils.widgets.get(\"chave_acesso\").strip()\n",
    "\n",
    "if not (len(chave) == 44 and chave.isdigit()):\n",
    "    raise ValueError(\"A chave deve conter 44 dígitos.\")\n",
    "\n",
    "# 2. Recuperar token do Secret Scope\n",
    "token = dbutils.secrets.get(\n",
    "    scope=\"infosimples\",\n",
    "    key=\"api_token\"\n",
    ")\n",
    "\n",
    "# 3. Consultar a API Infosimples\n",
    "response = requests.post(\n",
    "    URL,\n",
    "    data={\n",
    "        \"token\": token,\n",
    "        \"nfce\": chave,\n",
    "        \"timeout\": 60\n",
    "    },\n",
    "    timeout=75\n",
    ")\n",
    "\n",
    "response.raise_for_status()\n",
    "\n",
    "resultado = response.json()\n",
    "\n",
    "print(\"Código:\", resultado.get(\"code\"))\n",
    "print(\"Mensagem:\", resultado.get(\"code_message\"))\n",
    "\n",
    "# 4. Verificar sucesso\n",
    "if resultado.get(\"code\") != 200:\n",
    "    raise RuntimeError(\n",
    "        f\"Erro na consulta: {resultado.get('code_message')}\"\n",
    "    )\n",
    "\n",
    "\n",
    "arquivo = f"{VOLUME}/nfce_{chave}.json"\n",
    "\n",
    "with open(arquivo, \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump(\n",
    "        resultado,\n",
    "        f,\n",
    "        ensure_ascii=False,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "print(\"JSON salvo com sucesso!\")\n",
    "print(\"Arquivo:\", arquivo)\n"
   ]
  }
 ],
